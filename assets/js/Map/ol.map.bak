function AnimatePoint(feature, distance = 100, speed = 0.5) {
	// console.log("Geometry: ", feature.getGeometry().getCoordinates());
	var c = feature.getGeometry().getCoordinates();
	var start = c[1];
	var end = start + (distance / nilaiZoom);
	var curr = start;
	var up = true;

	let intervalId = window.setInterval(() => {
		if (up) {
			curr += speed;
			if (curr > end) {
				up = false;
			}
		} else {
			curr -= speed;
			if (curr < start) {
				up = true;
			}
		}
		var pos = [c[0], curr];
		feature.getGeometry().setCoordinates(pos);
	}, 35);

	// Hentikan interval jika tidak lagi diperlukan
	return () => clearInterval(intervalId);
}


// Configuration Constants
const GEOCODE_MIN_DELAY = 5000; // 5 seconds between geocoding requests
const MAX_MARKERS = 10; // Maximum markers to show
const DEFAULT_ZOOM = 12;
const DEFAULT_CENTER = [110.422, -6.992]; // Initial map center [lon, lat]

// State Variables
let lastGeocodeTime = 0;
let markers = [];
let nilaiZoom = DEFAULT_ZOOM;

// Geocoding Functions
async function LocationGeocoding(address) {
	if (!address.trim()) {
		console.error('Address cannot be empty');
		return;
	}

	try {
		// const now = Date.now();
		// if (now - lastGeocodeTime < GEOCODE_MIN_DELAY) {
		// 	console.log('Geocoding too fast - throttled');
		// 	return;
		// }
		// lastGeocodeTime = now;

		const response = await fetch(
			`https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(address)}&format=jsonv2`
		);

		if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);

		const results = await response.json();
		if (!results || results.length === 0) {
			throw new Error('No results found for this address');
		}

		const bestMatch = results[0];
		updateLocationUI(bestMatch);
		SetMarker(bestMatch);

	} catch (error) {
		console.error('Geocoding failed:', error);
		// alert(`Geocoding error: ${error.message}`);
	}
}

function updateLocationUI(location) {
	const locInput = document.getElementById('location_input');
	if (locInput) {
		locInput.value = `${location.lat},${location.lon}`;
	}
}

// Marker Functions
function SetMarker(locationData) {
	const feature = new ol.Feature({
		geometry: new ol.geom.Point(ol.proj.fromLonLat([locationData.lon, locationData.lat])),
		name: 'Location',
		desc: formatPopupContent(locationData),
		lat: locationData.lat,
		lon: locationData.lon
	});

	feature.setStyle(createMarkerStyle());
	straitSource.addFeature(feature);
	markers.push(feature);

	// Maintain marker limit
	if (markers.length > MAX_MARKERS) {
		const oldest = markers.shift();
		straitSource.removeFeature(oldest);
	}

	CenterMap(locationData.lon, locationData.lat);
}

function createMarkerStyle() {
	return new ol.style.Style({
		image: new ol.style.Icon({
			src: 'assets/icon-svg/icon-location-pin.svg',
			scale: 0.8,
			anchor: [0.5, 1],
			anchorXUnits: 'fraction',
			anchorYUnits: 'fraction'
		})
	});
}

function clearMarkers() {
	markers.forEach(marker => straitSource.removeFeature(marker));
	markers = [];
	straitSource.removeFeature(lastMarker)
	$
}

// Map Interaction Functions
function CenterMap(long, lat, zoom = DEFAULT_ZOOM) {
	map.getView().setCenter(ol.proj.transform([long, lat], 'EPSG:4326', 'EPSG:3857'));
	map.getView().setZoom(zoom);
}

// Event Listeners
map.on('pointermove', function (evt) {
	const feature = map.forEachFeatureAtPixel(evt.pixel, feat => feat);

	if (feature) {
		const position = ol.proj.transform(
			[feature.get('lon'), feature.get('lat')],
			'EPSG:4326',
			'EPSG:3857'
		);
		document.getElementById('popup-content').innerHTML = feature.get('desc');
		MarkerOnTop(feature, true);
		popup.setPosition(position);
	} else {
		straitSource.getFeatures().forEach(f => MarkerOnTop(f, false));
		popup.setPosition(undefined);
	}
});

map.on('click', function (evt) {
	const feature = map.forEachFeatureAtPixel(evt.pixel, feat => feat);

	if (feature) {
		const position = ol.proj.transform(
			[feature.get('lon'), feature.get('lat')],
			'EPSG:4326',
			'EPSG:3857'
		);
		document.getElementById('popup-content-click').innerHTML = feature.get('desc');
		MarkerOnTop(feature, true);
		popupClick.setPosition(position);
	} else {
		popupClick.setPosition(undefined);
	}
});

nilaiZoom = map.getView().getZoom();
map.on('moveend', function (e) {
	const newZoom = map.getView().getZoom();
	if (nilaiZoom !== newZoom) {
		nilaiZoom = newZoom;
	}
});

// Helper Functions
function MarkerOnTop(feature, show = false) {
	const style = feature.getStyle();
	style.zIndex = show ? 9999 : 999;
	style.zIndex_ = show ? 9999 : 999;
	feature.setStyle(style);
}

function formatPopupContent(location) {
	return `
    <div class="ol-tooltip">
      <strong>${location.display_name || 'Location'}</strong><br>
      Latitude: ${location.lat}<br>
      Longitude: ${location.lon}<br>
      <a href="https://www.google.com/maps?q=${location.lat},${location.lon}" target="_blank">
        View on Google Maps
      </a>
    </div>
  `;
}

// UI Event Handlers
function getAddress(e) {
	LocationGeocoding(e.value);
}

function getLatLing(e) {
	console.log('Coordinate input:', e.value);
}




